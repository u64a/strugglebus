                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="2,10">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <Border Style="{StaticResource KindBadge}" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding StateLabel}" FontFamily="{StaticResource Mono}" FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
