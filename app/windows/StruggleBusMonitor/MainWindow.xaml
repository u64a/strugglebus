                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasAlerts}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border x:Name="AdminAddHostPanel" Style="{StaticResource Card}">
