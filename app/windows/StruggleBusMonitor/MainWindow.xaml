<Window x:Class="StruggleBusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StruggleBusMonitor"
        Title="StruggleBus Monitor" Height="820" Width="1280" MinHeight="620" MinWidth="980"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" Icon="icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="ThemeCard">
                <Button Style="{StaticResource ThemeCardButton}" Click="ThemeCard_Click" ToolTip="{Binding Name}"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="STRUGGLEBUS" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentText}"/>
                    <TextBlock Text="Operator console" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="QuickFindButton" Grid.Column="1" Style="{StaticResource SearchTrigger}" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="False" Click="QuickFindButton_Click"/>
                <Button x:Name="UpdateButton" Grid.Column="2" Style="{StaticResource Btn}" Padding="12,6" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="Collapsed" Click="UpdateRestart_Click"/>
                <Border Grid.Column="3" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Warn}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="StatusText" Text="NOT ENROLLED" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusDetailText" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" MaxWidth="340" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="DeviceLabelText" Grid.Column="4" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border Background="{DynamicResource S1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="0,10" LastChildFill="False">
                    <RadioButton x:Name="SettingsNav" DockPanel.Dock="Bottom" GroupName="Nav" Style="{StaticResource NavItem}" Content="Settings" Tag="{StaticResource IconSettings}" Checked="Nav_Checked"/>
                    <RadioButton x:Name="MonitorNav" DockPanel.Dock="Top" GroupName="Nav" Style="{StaticResource NavItem}" Content="Monitor" Tag="{StaticResource IconMonitor}" Checked="Nav_Checked"/>
                    <Grid DockPanel.Dock="Top">
                        <RadioButton x:Name="HumansNav" GroupName="Nav" Style="{StaticResource NavItem}" Content="Humans" Tag="{StaticResource IconHumans}" IsEnabled="False" Checked="Nav_Checked"/>
                        <Border x:Name="HumansBadge" Background="{DynamicResource Accent}" CornerRadius="8" Padding="5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="HumansBadgeText" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource OnAccent}"/>
                        </Border>
                    </Grid>
                    <RadioButton x:Name="ChannelsNav" DockPanel.Dock="Top" GroupName="Nav" Style="{StaticResource NavItem}" Content="Channels" Tag="{StaticResource IconChannels}" IsEnabled="False" Checked="Nav_Checked"/>
                    <RadioButton x:Name="HostsNav" DockPanel.Dock="Top" GroupName="Nav" Style="{StaticResource NavItem}" Content="Hosts" Tag="{StaticResource IconHosts}" IsEnabled="False" Checked="Nav_Checked"/>
                    <RadioButton x:Name="AdminNav" DockPanel.Dock="Top" GroupName="Nav" Style="{StaticResource NavItem}" Content="Admin" Tag="{StaticResource IconAdmin}" IsEnabled="False" Checked="Nav_Checked"/>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">

                <!-- Enrollment -->
                <Border x:Name="EnrollmentPanel" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="30">
                    <StackPanel>
                        <TextBlock Text="DEVICE ENROLLMENT" Style="{StaticResource Label}"/>
                        <TextBlock Text="Connect this PC to your StruggleBus" FontSize="24" FontWeight="SemiBold" Margin="0,9,0,6"/>
                        <TextBlock Text="Paste the short-lived enrollment JSON from the StruggleBus device console. The server certificate fingerprint is checked before the token is sent." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,0,0,20"/>
                        <TextBox x:Name="EnrollmentBox" MinHeight="116" MaxHeight="220" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Mono}" Tag="Paste enrollment JSON here" VerticalContentAlignment="Top"/>
                        <DockPanel Margin="0,16,0,0">
                            <Button x:Name="EnrollButton" DockPanel.Dock="Right" Content="Verify and enroll" Style="{StaticResource Btn}" Click="Enroll_Click"/>
                            <TextBlock Text="Single use. Expires 2 to 5 minutes after it is created." Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Grid x:Name="WorkspacePanel" Visibility="Collapsed">

                    <!-- Monitor -->
                    <Grid x:Name="MonitorPage">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,14,14,10">
                                    <TextBlock Text="AGENTS" Style="{StaticResource Label}" Foreground="{DynamicResource Fg}"/>
                                    <TextBlock x:Name="AgentCountText" Style="{StaticResource MutedMono}" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBox x:Name="AgentFilterBox" DockPanel.Dock="Top" Margin="12,0,12,10" Tag="Filter agents by name or host" TextChanged="AgentFilterBox_TextChanged"/>
                                <TextBlock DockPanel.Dock="Bottom" Text="Click an agent to show only its messages. Click it again to clear." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="14,10"/>
                                <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource Line}"/>
                                <Grid>
                                    <ListBox x:Name="AgentList" ItemContainerStyle="{StaticResource RowItem}" SelectionMode="Single" PreviewMouseLeftButtonDown="AgentList_PreviewMouseLeftButtonDown" SelectionChanged="AgentList_SelectionChanged" ScrollViewer.CanContentScroll="False">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="10,8,12,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl Content="{Binding Presence}" ContentTemplate="{StaticResource PresenceDot}" VerticalAlignment="Center" Margin="0,0,10,0" Focusable="False"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding CountLabel}" Style="{StaticResource MutedMono}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Messages from this agent currently loaded"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="AgentEmptyText" Text="No agent matches that filter." Style="{StaticResource MutedText}" Margin="14,16" Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <DockPanel Grid.Column="1">
                            <ListBox x:Name="ChannelFilter" DockPanel.Dock="Top" Margin="16,12,16,8" SelectionMode="Single" SelectionChanged="ChannelFilter_SelectionChanged" ItemContainerStyle="{StaticResource ChipItem}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Label}" FontFamily="{StaticResource Mono}" FontSize="12"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,0,16,12">
                                <DockPanel>
                                    <TextBox x:Name="MessageFilterBox" DockPanel.Dock="Left" Width="300" Tag="Filter messages by text" TextChanged="MessageFilterBox_TextChanged"/>
                                    <Button x:Name="AgentChip" DockPanel.Dock="Left" Style="{StaticResource ChipButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="AgentChip_Click" ToolTip="Clear the agent filter"/>
                                    <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource BtnGhost}" Margin="12,0,0,0" Click="Refresh_Click" ToolTip="Reload the latest snapshot from the bus"/>
                                    <TextBlock x:Name="ActivityCountText" Style="{StaticResource MutedMono}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="ActivityHoldBar" DockPanel.Dock="Bottom" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,9" Visibility="Collapsed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Jump to latest" Style="{StaticResource Btn}" Padding="12,5" Click="ActivityJump_Click"/>
                                    <TextBlock x:Name="ActivityHoldText" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>
                            <Grid>
                                <ListBox x:Name="ActivityList" ItemContainerStyle="{StaticResource FeedItem}" ScrollViewer.CanContentScroll="False" ScrollViewer.ScrollChanged="ActivityList_ScrollChanged" MouseDoubleClick="ActivityList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="16,11" Background="Transparent">
                                                <Grid.ContextMenu>
                                                    <ContextMenu Style="{StaticResource Menu}">
                                                        <MenuItem Header="Reply in Humans" Tag="{Binding}" Style="{StaticResource MenuRow}" Click="ReplyToMessage_Click"/>
                                                        <MenuItem Header="Quote in Humans" Tag="{Binding}" Style="{StaticResource MenuRow}" Click="QuoteMessage_Click"/>
                                                        <MenuItem Header="Copy" Tag="{Binding}" Style="{StaticResource MenuRow}" Click="CopyMessage_Click"/>
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource MutedMono}" Margin="0,1,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SequenceLabel}" Style="{StaticResource MutedMono}" FontSize="11" VerticalAlignment="Center"/>
                                                        <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource BtnGhost}" Tag="{Binding}" Click="CopyMessage_Click" Margin="0,-3,10,-3" Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVisibility}}"/>
                                                        <TextBlock Text="{Binding AgentName}" FontFamily="{StaticResource Mono}" FontWeight="Bold" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ChannelLabel}" Style="{StaticResource MutedMono}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        <Border Style="{StaticResource KindBadge}" Margin="10,0,0,0" HorizontalAlignment="Left"><TextBlock Text="{Binding KindLabel}" Style="{StaticResource MutedMono}" FontSize="11"/></Border>
                                                    </DockPanel>
                                                    <TextBlock local:RichText.Text="{Binding DisplayBody}" local:RichText.Highlight="{Binding Highlight}" TextWrapping="Wrap" FontSize="14" LineHeight="20" Margin="0,5,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                                                                <Setter Property="MaxHeight" Value="60"/>
                                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="MaxHeight" Value="100000"/>
                                                                        <Setter Property="TextTrimming" Value="None"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Content="{Binding ExpandLabel}" Visibility="{Binding ExpandVisibility}" Style="{StaticResource LinkButton}" Tag="{Binding}" Click="ExpandMessage_Click" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="EmptyActivityText" Text="No messages match. Clear a filter to see more." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>
                    </Grid>

                    <!-- Humans -->
                    <Grid x:Name="HumansPage" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="270"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
                                <DockPanel>
                                    <TextBlock x:Name="HumansCountText" DockPanel.Dock="Right" Style="{StaticResource MutedMono}" VerticalAlignment="Center"/>
                                    <TextBlock Text="#humans" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HumansNotice" Style="{StaticResource MutedText}" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>

                            <Border DockPanel.Dock="Bottom" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12,20,12">
                                <StackPanel>
                                    <DockPanel x:Name="HumansReplyBanner" Visibility="Collapsed" Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Cancel reply" Style="{StaticResource BtnGhost}" Click="HumansCancelReply_Click" Margin="12,0,0,0"/>
                                        <TextBlock x:Name="HumansReplyText" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,10,0">
                                            <RadioButton x:Name="HumansKindChat" GroupName="HumanKind" Content="Chat" IsChecked="True" Style="{StaticResource SegItem}"/>
                                            <RadioButton x:Name="HumansKindQuestion" GroupName="HumanKind" Content="Question" Style="{StaticResource SegItem}" Margin="-1,0,0,0"/>
                                            <RadioButton x:Name="HumansKindAnswer" GroupName="HumanKind" Content="Answer" Style="{StaticResource SegItem}" Margin="-1,0,0,0"/>
                                        </StackPanel>
                                        <TextBox x:Name="HumansComposer" Grid.Column="1" MinHeight="40" MaxHeight="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000" FontSize="14" Tag="Message #humans. Type @ to mention an agent." PreviewKeyDown="HumansComposer_PreviewKeyDown" TextChanged="HumansComposer_TextChanged" SelectionChanged="HumansComposer_SelectionChanged" LostKeyboardFocus="HumansComposer_LostKeyboardFocus"/>
                                        <Button x:Name="HumansSendButton" Grid.Column="2" Content="Send" Style="{StaticResource Btn}" Click="HumansSend_Click" Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                                    </Grid>
                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock x:Name="HumansCharCount" DockPanel.Dock="Right" Text="0 / 4000" Style="{StaticResource MutedMono}"/>
                                        <TextBlock Text="Enter sends.  Shift+Enter adds a new line.  @ mentions an agent." Style="{StaticResource MutedText}"/>
                                    </DockPanel>
                                    <Popup x:Name="MentionPopup" PlacementTarget="{Binding ElementName=HumansComposer}" Placement="Top" VerticalOffset="-6" StaysOpen="True" AllowsTransparency="True" Focusable="False">
                                        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Width="400" Margin="0,0,0,4">
                                            <StackPanel>
                                                <TextBlock x:Name="MentionHeader" Style="{StaticResource Label}" Margin="14,10,14,6"/>
                                                <ListBox x:Name="MentionList" ItemContainerStyle="{StaticResource RowItem}" Focusable="False" MaxHeight="300" PreviewMouseLeftButtonDown="MentionList_PreviewMouseLeftButtonDown">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <DockPanel Margin="12,8,14,8">
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                                <ContentControl DockPanel.Dock="Left" Content="{Binding Presence}" ContentTemplate="{StaticResource PresenceDot}" VerticalAlignment="Center" Margin="0,0,10,0" Width="8" Focusable="False"/>
                                                                <TextBlock Text="{Binding Display}" FontFamily="{StaticResource Mono}" FontWeight="Bold"/>
                                                            </DockPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,8">
                                                    <TextBlock Text="Up and Down move.  Tab or Enter inserts.  Esc dismisses." Style="{StaticResource MutedText}"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>

                            <Border x:Name="HumansNewBar" DockPanel.Dock="Bottom" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,9" Visibility="Collapsed">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Jump to latest" Style="{StaticResource Btn}" Padding="12,5" Click="HumansJump_Click"/>
                                    <TextBlock x:Name="HumansNewText" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Grid>
                                <ListBox x:Name="HumansList" ItemContainerStyle="{StaticResource ChatItem}" ScrollViewer.CanContentScroll="False" ScrollViewer.ScrollChanged="HumansList_ScrollChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- Your own messages sit on the right, like a text conversation; agents are on the left. -->
                                            <Border Margin="20,6" Padding="14,10" CornerRadius="10" MaxWidth="760" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                                        <Setter Property="Background" Value="{DynamicResource S1}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOperator}" Value="True">
                                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                                <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding AuthorLabel}" FontFamily="{StaticResource Mono}" FontWeight="Bold" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOperator}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Fg}"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border Style="{StaticResource KindBadge}" Margin="10,0,0,0"><TextBlock Text="{Binding KindLabel}" Style="{StaticResource MutedMono}" FontSize="11"/></Border>
                                                        <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource MutedMono}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding StateLabel}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding ReplyContext}" Visibility="{Binding ReplyContextVisibility}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                    <!-- Selectable, so a command an agent asks for can be picked out and copied. -->
                                                    <local:SelectableTextBlock local:RichText.Text="{Binding Body}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding Error}" Visibility="{Binding ErrorVisibility}" Foreground="{DynamicResource Bad}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <Button Content="Reply" Tag="{Binding}" Visibility="{Binding ReplyVisibility}" Style="{StaticResource BtnGhost}" Click="HumansReply_Click" Margin="0,0,8,0"/>
                                                        <Button Content="Copy" Tag="{Binding}" Visibility="{Binding CopyVisibility}" Style="{StaticResource BtnGhost}" Click="CopyHumans_Click" Margin="0,0,8,0"/>
                                                        <Button Content="Retry" Tag="{Binding}" Visibility="{Binding RetryVisibility}" Style="{StaticResource BtnGhost}" Click="HumansRetry_Click" Margin="0,0,8,0"/>
                                                        <Button Content="Discard" Tag="{Binding}" Visibility="{Binding DiscardVisibility}" Style="{StaticResource BtnGhost}" Click="HumansDiscard_Click"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="HumansEmptyText" Text="No messages on #humans yet." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                        </DockPanel>

                        <Border Grid.Column="1" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
                                    <Button x:Name="WaitingClearAll" DockPanel.Dock="Right" Content="Clear all" Style="{StaticResource BtnGhost}" Click="WaitingClearAll_Click"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="WAITING ON YOU" Style="{StaticResource Label}" Foreground="{DynamicResource Fg}"/>
                                        <TextBlock x:Name="WaitingCountText" Style="{StaticResource MutedMono}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="WaitingHint" DockPanel.Dock="Bottom" Text="Questions from agents that you have not replied to. Click one to jump to it and start a reply." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="16,12"/>
                                <ListBox x:Name="WaitingList" ItemContainerStyle="{StaticResource RowItem}" SelectionChanged="WaitingList_SelectionChanged" ScrollViewer.CanContentScroll="False">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="14,10,10,10">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="Clear" Tag="{Binding}" ToolTip="Remove from this list. The message stays in the conversation." Style="{StaticResource BtnGhost}" Click="WaitingClear_Click"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AgentName}" FontFamily="{StaticResource Mono}" FontWeight="Bold" Foreground="{DynamicResource AccentText}"/>
                                                        <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource MutedMono}" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Channels -->
                    <ScrollViewer x:Name="ChannelsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="940" Margin="28,22">
                            <DockPanel>
                                <Button x:Name="ChannelsReload" DockPanel.Dock="Right" Content="Reload" Style="{StaticResource BtnGhost}" Click="ChannelsReload_Click"/>
                                <TextBlock Text="CHANNELS" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="ChannelsSummary" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                            <TextBlock Text="What each channel is for, how busy it is and how many agents are listening. A channel's purpose is written by whoever made it; read it before posting there." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                            <ItemsControl x:Name="ChannelsList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <StackPanel>
                                                <DockPanel>
