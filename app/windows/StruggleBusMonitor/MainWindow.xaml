                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource MutedText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
