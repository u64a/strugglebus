                                                                    <DataTrigger Binding="{Binding IsDanger}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Bad}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource KindBadge}" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding StateLabel}" FontFamily="{StaticResource Mono}" FontSize="11">
