                                    <TextBlock Text="Audit reason" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="GrantReason" Text="Windows operator setup"/>
                                    <Button Content="Save operator access" Style="{StaticResource Btn}" Click="Grant_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="FREEZE" Style="{StaticResource Label}"/>
                                    <TextBlock Text="A freeze denies every agent at once and ends their open streams. This app and the console keep working. Clearing it does not unblock agents you blocked meanwhile. Uses the audit reason above." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,14"/>
                                    <WrapPanel>
                                        <Button Content="Activate freeze" Style="{StaticResource BtnDanger}" Click="Freeze_Click" Margin="0,0,8,0"/>
                                        <Button Content="Clear freeze" Style="{StaticResource BtnOutline}" Click="ClearFreeze_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>

                            <Border x:Name="AdminExportPanel" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="EXPORT ACTIVITY" Style="{StaticResource Label}"/>
                                    <TextBlock Text="Saves the latest 200 messages the bus keeps as CSV. Times are this PC's local time. Leave a box empty for no limit." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="From" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="ExportFrom" FontFamily="{StaticResource Mono}" Tag="YYYY-MM-DD HH:mm"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="To" Style="{StaticResource FieldLabel}"/>
                                            <TextBox x:Name="ExportTo" FontFamily="{StaticResource Mono}" Tag="YYYY-MM-DD HH:mm"/>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="Export CSV" Style="{StaticResource Btn}" Click="ExportCsv_Click" Margin="0,0,8,0"/>
                                        <Button Content="Last 24 hours" Style="{StaticResource BtnOutline}" Click="ExportLastDay_Click" Margin="0,0,8,0"/>
                                        <Button Content="Clear dates" Style="{StaticResource BtnOutline}" Click="ClearExportFilter_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Settings (available before enrollment too) -->
                <DockPanel x:Name="SettingsPage" Visibility="Collapsed" Background="{DynamicResource Bg}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="28,18,28,0">
                        <RadioButton x:Name="SettingsTabGeneral" GroupName="SettingsTab" Content="General" IsChecked="True" Style="{StaticResource SegItem}" Checked="SettingsTab_Checked"/>
                        <RadioButton x:Name="SettingsTabAppearance" GroupName="SettingsTab" Content="Appearance" Style="{StaticResource SegItem}" Margin="-1,0,0,0" Checked="SettingsTab_Checked"/>
                        <RadioButton x:Name="SettingsTabLogs" GroupName="SettingsTab" Content="Logs" Style="{StaticResource SegItem}" Margin="-1,0,0,0" Checked="SettingsTab_Checked"/>
                    </StackPanel>
                    <Grid>
                <ScrollViewer x:Name="SettingsGeneralPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22">
                        <TextBlock Text="General" FontSize="22" FontWeight="SemiBold"/>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="WINDOW" Style="{StaticResource Label}"/>
                                <CheckBox x:Name="KeepInTrayCheck" Content="Keep running in the system tray when I close the window" Style="{StaticResource Check}" Margin="0,12,0,0" Checked="KeepInTray_Changed" Unchecked="KeepInTray_Changed"/>
                                <TextBlock Text="The app keeps watching the bus. Open it again from its tray icon, or right-click the icon to quit." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <CheckBox x:Name="StartAtSignInCheck" Content="Start when I sign in to Windows, in the tray" Style="{StaticResource Check}" Margin="0,12,0,0" Checked="StartAtSignIn_Changed" Unchecked="StartAtSignIn_Changed"/>
                                <TextBlock Text="Needs the option above, and a copy installed with the Setup program." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="UPDATES" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="VersionText" FontFamily="{StaticResource Mono}" FontSize="14" Margin="0,8,0,0"/>
                                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="UpdateSourceText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <CheckBox x:Name="AutoUpdateCheck" Content="Install updates automatically" Style="{StaticResource Check}" Margin="0,12,0,0" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button x:Name="UpdateCheckButton" Content="Check for updates" Style="{StaticResource BtnOutline}" Click="UpdateCheck_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="UpdateRestartButton" Content="Restart to update" Style="{StaticResource Btn}" Click="UpdateRestart_Click" Visibility="Collapsed"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ThisPcCard" Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="THIS PC" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="ThisPcText" FontFamily="{StaticResource Mono}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="Forgetting removes the saved enrollment and operator access from this PC so you can enroll again. It does not revoke the device on the bus; use Admin for that while you still can." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <Button Content="Forget this PC" Style="{StaticResource BtnOutline}" Click="ForgetDevice_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="ABOUT" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="AboutWhatText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="AboutOwnerText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="AboutLicenceText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <ItemsControl x:Name="AboutLinks" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Tag="{Binding}" ToolTip="{Binding Url}" Style="{StaticResource BtnOutline}" Click="AboutLink_Click" Margin="0,0,8,8"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="AboutLinksNote" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsAppearancePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <RadioButton x:Name="ModeDark" GroupName="ThemeMode" Content="Dark" Style="{StaticResource SegItem}" Checked="ThemeMode_Checked"/>
                                <RadioButton x:Name="ModeLight" GroupName="ThemeMode" Content="Light" Style="{StaticResource SegItem}" Margin="-1,0,0,0" Checked="ThemeMode_Checked"/>
                                <RadioButton x:Name="ModeSystem" GroupName="ThemeMode" Content="Match Windows" Style="{StaticResource SegItem}" Margin="-1,0,0,0" Checked="ThemeMode_Checked"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Pick one dark and one light theme. The mode decides which is showing." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="DARK THEMES" Style="{StaticResource Label}" Margin="0,20,0,8"/>
                        <ItemsControl x:Name="DarkThemeList" ItemTemplate="{StaticResource ThemeCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="LIGHT THEMES" Style="{StaticResource Label}" Margin="0,18,0,8"/>
                        <ItemsControl x:Name="LightThemeList" ItemTemplate="{StaticResource ThemeCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="5"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                    <Grid x:Name="SettingsLogsPanel" Visibility="Collapsed" Margin="28,16,28,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="280"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <!-- What this app saw: outages, reconnects, restarts -->
                        <Border Style="{StaticResource Card}" Margin="0" Padding="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="20,18,20,12">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Copy" Style="{StaticResource BtnGhost}" Click="ConnectionLogCopy_Click" Margin="0,-4,6,-4"/>
                                            <Button Content="Clear" Style="{StaticResource BtnGhost}" Click="ConnectionLogClear_Click" Margin="0,-4,0,-4"/>
                                        </StackPanel>
                                        <TextBlock Text="THIS APP'S CONNECTION" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <TextBlock Text="When this PC lost the bus and when it got it back. Reconnecting is automatic." Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                                <Grid>
                                    <ListBox x:Name="ConnectionLogList" ItemContainerStyle="{StaticResource FeedItem}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="20,9">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,10,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Ok}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Warn}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter Property="Fill" Value="{DynamicResource Bad}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource MutedMono}" FontSize="11"/>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="ConnectionLogEmpty" Text="Nothing logged yet." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- What the bus itself logged -->
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0" Padding="0">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="20,18,20,12">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Copy" Style="{StaticResource BtnGhost}" Click="BusLogCopy_Click" Margin="0,-4,6,-4"/>
                                            <Button Content="Refresh" Style="{StaticResource BtnGhost}" Click="BusLogRefresh_Click" Margin="0,-4,0,-4"/>
                                        </StackPanel>
                                        <TextBlock Text="BUS LOG" Style="{StaticResource Label}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="BusLogStatus" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <DockPanel Margin="0,12,0,0">
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                                            <RadioButton x:Name="BusLogAll" GroupName="BusLogKind" Content="All" IsChecked="True" Style="{StaticResource SegItem}" Checked="BusLogFilter_Changed"/>
                                            <RadioButton x:Name="BusLogProblems" GroupName="BusLogKind" Content="Problems" Style="{StaticResource SegItem}" Margin="-1,0,0,0" Checked="BusLogFilter_Changed"/>
                                        </StackPanel>
                                        <TextBox x:Name="BusLogFilter" Tag="Filter by event, agent, address…" TextChanged="BusLogFilter_Changed"/>
                                    </DockPanel>
                                </StackPanel>
                                <Grid>
                                    <ListBox x:Name="BusLogList" ItemContainerStyle="{StaticResource FeedItem}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="20,8">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,10,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource Muted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Ok}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Warn}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Bad"><Setter Property="Fill" Value="{DynamicResource Bad}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource MutedMono}" FontSize="11" VerticalAlignment="Center"/>
                                                            <Border Style="{StaticResource KindBadge}" Margin="10,0,0,0"><TextBlock Text="{Binding SourceLabel}" Style="{StaticResource MutedMono}" FontSize="11"/></Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Event}" FontFamily="{StaticResource Mono}" FontSize="13" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="BusLogEmpty" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Notice bar: non-modal errors and status -->
        <Border x:Name="NoticeBar" Grid.Row="2" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Warn}" BorderThickness="0,2,0,0" Padding="16,10" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource BtnGhost}" Click="NoticeDismiss_Click" Margin="12,0,0,0" VerticalAlignment="Top"/>
                <Button x:Name="NoticeActionButton" DockPanel.Dock="Right" Style="{StaticResource BtnOutline}" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Top" Visibility="Collapsed" Click="NoticeAction_Click"/>
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Quick find overlay -->
        <Grid x:Name="QuickFindOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed">
            <Border Background="{DynamicResource Scrim}" MouseLeftButtonDown="QuickFindScrim_MouseDown"/>
            <Border Width="720" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,92,0,0" Background="{DynamicResource S1}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBox x:Name="QuickFindBox" Style="{StaticResource BareTextBox}" FontSize="18" Padding="18,14" Tag="Find an agent or a message" TextChanged="QuickFindBox_TextChanged" PreviewKeyDown="QuickFindBox_PreviewKeyDown"/>
                    <Border Height="1" Background="{DynamicResource Line}"/>
                    <DockPanel Margin="18,10,18,6">
                        <TextBlock DockPanel.Dock="Right" Text="Narrow with from:name or in:#channel" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FindScopeAll" GroupName="FindScope" Content="All" IsChecked="True" Style="{StaticResource SegItem}" Checked="FindScope_Checked"/>
                            <RadioButton x:Name="FindScopeAgents" GroupName="FindScope" Content="Agents" Style="{StaticResource SegItem}" Margin="-1,0,0,0" Checked="FindScope_Checked"/>
                            <RadioButton x:Name="FindScopeMessages" GroupName="FindScope" Content="Messages" Style="{StaticResource SegItem}" Margin="-1,0,0,0" Checked="FindScope_Checked"/>
                        </StackPanel>
                    </DockPanel>
                    <ListBox x:Name="QuickFindList" ItemContainerStyle="{StaticResource RowItem}" MaxHeight="430" Focusable="False" ScrollViewer.CanContentScroll="False" PreviewMouseLeftButtonDown="QuickFindList_PreviewMouseLeftButtonDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,9,16,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Lead}" Style="{StaticResource MutedMono}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock local:RichText.Text="{Binding Title}" local:RichText.Highlight="{Binding Highlight}" FontFamily="{StaticResource Mono}" FontWeight="Bold" Foreground="{DynamicResource AccentText}"/>
                                        <TextBlock local:RichText.Text="{Binding Detail}" local:RichText.Highlight="{Binding Highlight}" TextTrimming="CharacterEllipsis" MaxHeight="40" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="QuickFindEmpty" Style="{StaticResource MutedText}" Margin="18,14" TextWrapping="Wrap"/>
                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="18,10">
                        <TextBlock Text="Up and Down move.  Enter opens.  Tab changes scope.  Esc closes." Style="{StaticResource MutedText}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
