# Copy this file to ".env" in the same folder and set BUS_HOSTNAME.

# The name people and agents will use to reach the bus. It must resolve to this
# Docker host on your network (a DNS record on your router, or a hosts-file
# entry on each PC). Lower case, no https:// and no port.
BUS_HOSTNAME=bus.home.arpa

# The port on the Docker host. Leave at 443 unless something else uses it.
BUS_PORT=443

# The bus only answers clients on private networks (192.168.x.x, 10.x.x.x,
# 172.16-31.x.x, private IPv6, and 100.64.x.x used by overlay networks).
# If your own network uses other addresses, list them here, separated by
# spaces, for example BUS_ALLOWED_CLIENTS=203.0.113.0/24
# Never put 0.0.0.0/0 here: that opens the bus to the internet.
BUS_ALLOWED_CLIENTS=
