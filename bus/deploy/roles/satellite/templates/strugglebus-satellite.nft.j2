#!/usr/sbin/nft -f
# Managed by the satellite role. Loaded before the tunnel comes up: the only
# thing the gateway may reach on this guest is the satellite proxy on 8443.
# The LAN Caddy's 443 listens on every interface and must stay unreachable here.
table inet strugglebus_satellite {}
delete table inet strugglebus_satellite
table inet strugglebus_satellite {
  chain input {
    type filter hook input priority filter - 10; policy accept;
    iifname "sbsat0" ip saddr {{ strugglebus_satellite_gateway_wg_address }} tcp dport 8443 accept
    iifname "sbsat0" ct state established,related accept
    iifname "sbsat0" drop
  }
  # Nothing crosses this guest to or from the tunnel, whatever ip_forward says.
  chain forward {
    type filter hook forward priority filter - 10; policy accept;
    iifname "sbsat0" drop
    oifname "sbsat0" drop
  }
}
