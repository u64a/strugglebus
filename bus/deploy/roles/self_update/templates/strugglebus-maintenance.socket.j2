[Unit]
Description=Strugglebus root maintenance supervisor IPC

[Socket]
ListenStream=/run/strugglebus-maintenance/control.sock
SocketUser=root
SocketGroup={{ strugglebus_service_group }}
SocketMode=0660
DirectoryMode=0755
Accept=no
Backlog=4
RemoveOnStop=true
Service=strugglebus-maintenance.service

[Install]
WantedBy=sockets.target
