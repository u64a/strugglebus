{
  "version": 1,
  "application_uid": {{ strugglebus_application_uid }},
  "service_user": {{ strugglebus_service_user | to_json }},
  "updater_socket": {{ strugglebus_updater_socket_path | to_json }},
  "updater_cache_state": "/var/lib/strugglebus-updater-cache/state",
  "state_path": "/var/lib/strugglebus-maintenance/supervisor.json",
  "database": {{ strugglebus_database_path | to_json }},
  "backup_dir": {{ strugglebus_backup_dir | to_json }},
  "release_root": {{ strugglebus_release_root | to_json }},
  "current_link": {{ strugglebus_current_link | to_json }},
  "updater_release_root": "/opt/strugglebus-updater/releases",
  "updater_current_link": "/opt/strugglebus-updater/current",
  "service_unit": "/etc/systemd/system/strugglebus.service",
  "maintenance_root": "/var/lib/strugglebus-maintenance",
  "health_url": {{ strugglebus_health_url | to_json }},
  "ca_path": {{ strugglebus_caddy_ca_path | to_json }},
  "python": "/usr/bin/python3.13",
  "uv": "/usr/local/bin/uv",
  "systemctl": "/usr/bin/systemctl",
  "runuser": "/usr/sbin/runuser",
  "release_lock_wait_seconds": 30,
  "release_lock_lease_seconds": 3600
}
