[Unit]
Description=Strugglebus isolated updater worker
Requires=strugglebus-updater.socket
After=strugglebus-updater.socket network-online.target
Wants=network-online.target
ConditionPathIsMountPoint=/var/lib/strugglebus-updater-cache
ConditionPathIsDirectory=/opt/strugglebus-updater/current/venv

[Service]
Type=simple
User=strugglebus-updater
Group=strugglebus-updater
SupplementaryGroups=
Sockets=strugglebus-updater.socket
WorkingDirectory=/var/lib/strugglebus-updater-cache/state
ExecStart=/opt/strugglebus-updater/current/venv/bin/python -I -m strugglebus.update_worker serve --config /etc/strugglebus-updater/worker.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= NO_PROXY=*
UMask=0077
Restart=no
TimeoutStartSec=30s
TimeoutStopSec=10s
KillMode=mixed
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/opt/strugglebus-updater/current /etc/strugglebus-updater /var/lib/strugglebus
ReadWritePaths=/var/lib/strugglebus-updater-cache/state
InaccessiblePaths=/tmp /var/tmp /etc/strugglebus /opt/strugglebus -/run/strugglebus -/run/credentials/strugglebus.service -{{ strugglebus_database_path }} -{{ strugglebus_backup_dir }}
MemoryMax=512M
MemorySwapMax=0
TasksMax=16
CPUWeight=10
CPUQuota=25%
IOWeight=10
LimitNOFILE=64
LimitCORE=0
StandardOutput=null
StandardError=null
