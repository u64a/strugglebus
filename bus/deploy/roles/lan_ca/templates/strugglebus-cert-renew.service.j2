[Unit]
Description=Renew the Strugglebus dedicated LAN certificate
After=network-online.target caddy.service
Wants=network-online.target
ConditionPathIsRegular={{ strugglebus_lan_ca_bundle_path }}

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
LoadCredential=jwk-password:{{ strugglebus_lan_ca_password_path }}
Environment=STRUGGLEBUS_LAN_CA_ENV=/etc/lan-ca/strugglebus-renew.env
ExecStart=/usr/local/libexec/strugglebus-renew-certificate
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths={{ strugglebus_tls_root }}
