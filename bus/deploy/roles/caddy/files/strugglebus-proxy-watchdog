#!/bin/bash
# Strugglebus proxy watchdog.
#
# The restart policy on caddy.service only catches a crash. It does nothing for
# a proxy that is running but no longer answering, and nothing once the start
# limit burst is exhausted. On 8 September 2026 the application stayed healthy
# on loopback for eighteen hours while clients could not reach it at all, so
# this probes the path a client actually uses rather than the service's own
# opinion of itself.
#
# Discrimination that matters: any HTTP response, including 502 or 503, proves
# Caddy is serving and the fault is behind it. Only a connection-level failure
# - no response, TLS failure, timeout - is a proxy fault. Restarting Caddy
# because the application is stopped for maintenance would be noise at best.
#
# A deliberately stopped unit is never restarted. The deployment stops Caddy
# after a failed configuration validation, and that stop must stay stopped.
#
# Every run logs exactly one status line. The first version of this script was
# silent when healthy, and when a counter bug stopped it working there was
# nothing to distinguish "watching and fine" from "not working at all" - the
# same silent-failure shape it exists to prevent.
set -uo pipefail

URL="${STRUGGLEBUS_WATCHDOG_URL:-https://bus.u64.lan/healthz}"
CA="${STRUGGLEBUS_WATCHDOG_CA:-/etc/strugglebus/lan-ca-root.crt}"
STATE_DIR="${RUNTIME_DIRECTORY:-/run/strugglebus-proxy-watchdog}"
FAILURES="$STATE_DIR/failures"
LAST_ACTION="$STATE_DIR/last-action"
THRESHOLD="${STRUGGLEBUS_WATCHDOG_THRESHOLD:-3}"
COOLDOWN="${STRUGGLEBUS_WATCHDOG_COOLDOWN:-600}"
TIMEOUT="${STRUGGLEBUS_WATCHDOG_TIMEOUT:-10}"

mkdir -p "$STATE_DIR" && chmod 0700 "$STATE_DIR"

# Read an integer, treating missing, empty and malformed alike. The previous
# version truncated the counter to an empty file when healthy and then did
# arithmetic on the empty string, which failed silently and meant the counter
# never advanced past one.
read_int() {
  local value
  value=$(cat "$1" 2>/dev/null || true)
  case "$value" in
    ''|*[!0-9]*) echo 0 ;;
    *) echo "$value" ;;
  esac
}

write_int() { printf '%s\n' "$2" >"$1"; }

# Sets code and curl_exit. curl's exit code tells a timeout (28) from a refused
# connection (7) or a TLS failure (35, 60), which a bare 000 does not.
probe() {
  local result
  result=$(curl -sS --max-time "$TIMEOUT" --cacert "$CA" \
    -o /dev/null -w '%{http_code}' "$URL" 2>/dev/null)
  curl_exit=$?
  case "$result" in
    ''|*[!0-9]*) code=000 ;;
    *) code=$result ;;
  esac
}

state=$(systemctl is-active caddy 2>/dev/null || true)

if [ "$state" = "inactive" ] || [ "$state" = "deactivating" ]; then
  echo "status=skipped unit=$state reason=deliberate-stop"
  write_int "$FAILURES" 0
  exit 0
fi

probe

if [ "$code" != "000" ]; then
  previous=$(read_int "$FAILURES")
  if [ "$previous" -gt 0 ]; then
    echo "status=recovered unit=$state http=$code after_failures=$previous"
  else
    echo "status=ok unit=$state http=$code"
  fi
  write_int "$FAILURES" 0
  exit 0
fi

count=$(( $(read_int "$FAILURES") + 1 ))
write_int "$FAILURES" "$count"

if [ "$count" -lt "$THRESHOLD" ]; then
  echo "status=probe-failed unit=$state http=000 curl_exit=$curl_exit attempt=$count/$THRESHOLD"
  exit 0
fi

# If Caddy answers on loopback, the client path is failing outside this guest
# (its network or DNS), and restarting Caddy cannot help. On 28 October 2026
# the guest lost its bridge port for nine hours and this restarted a healthy
# Caddy fifty times. A frozen Caddy fails here too, so it is still restarted.
probe_local() {
  local result
  result=$(curl -sS --max-time "$TIMEOUT" --cacert "$CA" --connect-to ::127.0.0.1: \
    -o /dev/null -w '%{http_code}' "$URL" 2>/dev/null)
  case "$result" in
    ''|*[!0-9]*|000) return 1 ;;
  esac
}
if probe_local; then
  echo "ALERT status=unreachable-outside-guest unit=$state curl_exit=$curl_exit attempt=$count" \
       "action=none -- Caddy answers on loopback; check this guest's network and DNS."
  exit 1
fi

now=$(date +%s)
last=$(read_int "$LAST_ACTION")
if [ "$last" -gt 0 ] && [ $(( now - last )) -lt "$COOLDOWN" ]; then
  echo "ALERT status=unreachable unit=$state attempt=$count action=none" \
       "reason=cooldown last_restart=$(( now - last ))s-ago" \
       "-- automatic recovery has already been tried. Needs a human."
  exit 1
fi

write_int "$LAST_ACTION" "$now"
echo "ALERT status=unreachable unit=$state curl_exit=$curl_exit attempt=$count action=restarting-caddy"
systemctl reset-failed caddy >/dev/null 2>&1 || true

if ! systemctl restart caddy; then
  echo "ALERT status=restart-failed -- caddy would not restart. Needs a human."
  exit 1
fi

sleep 3
probe

if [ "$code" != "000" ]; then
  echo "status=recovered-by-restart http=$code after_failures=$count"
  write_int "$FAILURES" 0
  exit 0
fi

echo "ALERT status=still-unreachable-after-restart -- Needs a human."
exit 1
