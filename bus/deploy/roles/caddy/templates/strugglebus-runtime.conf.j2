[Unit]
# A transient crash must not become an outage. Caddy 2.6.2 panicked inside Go's
# context teardown during a certificate-renewal reload on 8 September 2026 and,
# with the packaged Restart=no, stayed down for eighteen hours while the
# application behind it remained healthy. The burst window is wide enough to
# ride out a repeated reload panic and narrow enough that a genuinely broken
# configuration still stops rather than looping forever.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
RuntimeDirectory=caddy
RuntimeDirectoryMode=0750
UMask=0077
# on-failure, not always: the deployment deliberately stops Caddy after a failed
# configuration validation, and that stop must stay stopped.
Restart=on-failure
RestartSec=2s
